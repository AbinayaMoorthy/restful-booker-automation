            "type": "text"
          },
          {
            "key": "Cookie",
            "value": "token={{authToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Abinaya Final\",\r\n    \"totalprice\": 999\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking/{{newBookingId}}",
