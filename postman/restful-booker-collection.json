    {
      "name": "Verify Deletion (Negative Test)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted booking returns 404\", function() {\r",
              "    pm.response.to.have.status(404);\r",
              "});\r",
              "\r",
              "pm.test(\"Body confirms not found\", function() {\r",
              "    pm.expect(pm.response.text()).to.include('Not Found');\r",
              "});"
